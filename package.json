{
  "name": "sports-data-visualizer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "prepare": "sh scripts/install-git-hooks.sh",
    "dev": "npm run check:model && next dev",
    "build": "npm run check:model && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:precommit": "bash scripts/check-precommit.sh",
    "check:localization": "bash scripts/check-localization.sh",
    "check:model": "node scripts/check-model.mjs",
    "check:release": "python3 scripts/check_public_release.py",
    "check:browser": "node scripts/check-playground-browser.mjs"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "0.9.0",
    "negotiator": "1.1.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/negotiator": "0.6.4",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "esbuild": "0.28.2"
  }
}
