{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary_markdown", "threads"],
  "properties": {
    "summary_markdown": {
      "type": "string",
      "minLength": 1
    },
    "threads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "thread_id",
          "disposition",
          "rationale",
          "reply_markdown",
          "evidence",
          "changed_files",
          "validation"
        ],
        "properties": {
          "thread_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": ["fixed", "not_applicable", "outdated", "needs_human"]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "reply_markdown": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "changed_files": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "validation": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
