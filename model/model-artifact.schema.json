{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "positional-features/v1"
    },
    "feature_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "feature_order": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "string"
      }
    },
    "feature_indices": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 7
      }
    },
    "model_version": {
      "enum": [
        "geometry_logistic",
        "defenders_logistic",
        "full_logistic",
        "full_xgboost"
      ]
    },
    "objective": {
      "const": "binary:logistic"
    },
    "parameters": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "logistic"
            },
            "mean": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            },
            "scale": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            },
            "coefficients": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            },
            "intercept": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "mean",
            "scale",
            "coefficients",
            "intercept"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "xgboost"
            },
            "base_margin": {
              "type": "number"
            },
            "input_precision": {
              "const": "float32"
            },
            "accumulator_precision": {
              "const": "float32"
            },
            "trees": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 15,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "leaf": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "leaf"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "feature": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 7
                        },
                        "threshold": {
                          "type": "number"
                        },
                        "left": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "right": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "feature",
                        "threshold",
                        "left",
                        "right"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "required": [
            "kind",
            "base_margin",
            "input_precision",
            "accumulator_precision",
            "trees"
          ]
        }
      ]
    },
    "calibration": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "const": "identity"
            }
          },
          "required": [
            "method"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "const": "sigmoid"
            },
            "slope": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "intercept": {
              "type": "number"
            },
            "clip": {
              "const": 1e-12
            }
          },
          "required": [
            "method",
            "slope",
            "intercept",
            "clip"
          ]
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preparation_run_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "protocol_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "feature_run_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_revision": {
          "type": "string"
        },
        "split_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "code_sha256": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "preparation_run_id",
        "protocol_sha256",
        "feature_run_id",
        "source_revision",
        "split_sha256",
        "code_sha256",
        "dependencies"
      ]
    },
    "licensing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "libraries": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scikit-learn": {
              "const": "BSD-3-Clause"
            },
            "XGBoost": {
              "const": "Apache-2.0"
            }
          },
          "required": [
            "scikit-learn",
            "XGBoost"
          ]
        }
      },
      "required": [
        "data",
        "code",
        "libraries"
      ]
    },
    "export_tolerance": {
      "enum": [
        1e-10,
        1e-07
      ]
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "contract_version",
    "feature_contract_sha256",
    "feature_order",
    "feature_indices",
    "model_version",
    "objective",
    "parameters",
    "calibration",
    "provenance",
    "licensing",
    "export_tolerance",
    "artifact_id"
  ]
}
